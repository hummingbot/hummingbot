#!/bin/bash

cd $(dirname $0)

if ! command -v uv >/dev/null 2>&1; then
    echo "Please install uv first: https://docs.astral.sh/uv/getting-started/installation/"
    exit 1
fi

mkdir -p logs

# Parse command line arguments
USE_DYDX=false
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --dydx)
        USE_DYDX=true
        shift
        ;;
        *)
        # Handle other unidentified parameters
        shift
        ;;
    esac
done

UV_EXTRA=()
if [ "$USE_DYDX" = true ]; then
    UV_EXTRA=(--extra dydx)
    echo "install dydx version."
fi

uv sync "${UV_EXTRA[@]}"

# Expose the `hbot` CLI on PATH within the venv.
ln -sf "$(pwd)/bin/hbot" "$(pwd)/.venv/bin/hbot"

uv run pre-commit install

# Check for build-essential (only relevant for Debian-based systems)
if [ "$(uname)" = "Linux" ]; then
    if ! dpkg -s build-essential &> /dev/null; then
        echo "build-essential not found, installing..."
        sudo apt-get update && sudo apt-get upgrade -y
        sudo apt-get install -y build-essential
    fi
fi
