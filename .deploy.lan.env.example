# Copy to .deploy.lan.env (ignored by Git) for LAN-host deployment metadata.
# The target accepts the existing local SSH key/agent authentication.
# Do not store a password, private-key content, exchange credentials, or
# CONFIG_PASSWORD here.

LAN_SERVER_HOST=192.168.102.7
LAN_SERVER_USER=allenxing00
LAN_SSH_PORT=22
LAN_SSH_AUTH=agent
# Optional path to a specific private key. Leave blank to use ssh-agent/keychain.
LAN_SSH_KEY=

# This directory contains the Humm Control Plane, not the official Hummingbot
# execution engine. Keep their deployment paths separate.
LAN_CONTROL_PLANE_PATH=/Users/allenxing00/Documents/soft/hummingbot
LAN_ENGINE_PATH=/Users/allenxing00/Documents/soft/hummingbot-engine
# Keeps non-interactive Docker pulls independent from the macOS login keychain.
LAN_DOCKER_CONFIG=/Users/allenxing00/Documents/soft/hummingbot-engine/.docker
LAN_BUILDX_CONFIG=/Users/allenxing00/Documents/soft/hummingbot-engine/.buildx
LAN_PAPER_CONTAINER=hummingbot-pmm-mister-paper
LAN_ADMIN_BIND_HOST=192.168.102.7
LAN_ADMIN_PORT=3217
# Direct LAN access on the M2 host. Do not use 0.0.0.0 because this admin has
# paper start/stop controls backed by the local Docker socket.
LAN_ADMIN_URL=http://192.168.102.7:3217/admin

# Last verified state: Docker Desktop and docker compose are ready on this Mac.
LAN_REQUIRES_DOCKER_DESKTOP=false
