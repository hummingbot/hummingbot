[run]
source_pkgs = kairos
omit =
        kairos/core/management/*
        kairos/client/config/config_helpers.py
        kairos/client/config/conf_migration.py
        kairos/client/config/security.py
        kairos/client/kairos_application.py
        kairos/client/command/*
        kairos/client/settings.py
        kairos/client/ui/completer.py
        kairos/client/ui/layout.py
        kairos/client/tab/*
        kairos/client/ui/parser.py
        kairos/connector/derivative/position.py
        kairos/connector/derivative/dydx_v4_perpetual/*
        kairos/connector/derivative/dydx_v4_perpetual/data_sources/*
        kairos/connector/exchange/injective_v2/account_delegation_script.py
        kairos/connector/exchange/mexc/protobuf/*
        kairos/connector/exchange/paper_trade*
        kairos/connector/test_support/*
        kairos/core/utils/kill_switch.py
        kairos/core/utils/wallet_setup.py
        kairos/connector/mock*
        kairos/strategy/*/start.py
        kairos/strategy/dev*
        kairos/user/user_balances.py
        kairos/connector/exchange/cube/cube_ws_protobufs/*
        kairos/connector/exchange/ndax/*
        kairos/strategy/amm_arb/*
        kairos/strategy_v2/backtesting/*
dynamic_context = test_function
branch = true

[report]
fail_under = 70
precision = 2
skip_empty = true
exclude_lines =
    @(abc\.)?abstractmethod
    if TYPE_CHECKING:
    pragma: no cover
    if __name__ == .__main__.:
    if 0:
    raise AssertionError
    raise NotImplementedError
    if settings.DEBUG
    except asyncio.exceptions.TimeoutError:

[html]
directory = coverage_html_report
show_contexts = true

[xml]
output = coverage.xml
