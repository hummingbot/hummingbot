# Copy to .deploy.env and adjust if needed. This file is intentionally not
# required; scripts/deploy-hummingbot.sh has the same defaults baked in.

CLOUD_SERVER_IP=47.254.246.53
CLOUD_SERVER_USER=root
CLOUD_SSH_PORT=2222
CLOUD_SSH_KEY=/Users/xinghailong/Documents/soft/KKline/deploy/LH.pem
CLOUD_PROJECT_PATH=/opt/hummingbot
CLOUD_DOMAIN=humm.kline007.top
CLOUD_HEALTH_URL=https://humm.kline007.top/health
CLOUD_CONTAINER=hummingbot

# Set to gateway to include Hummingbot Gateway.
COMPOSE_PROFILES=

# Optional Hummingbot quickstart variables.
CONFIG_PASSWORD=
CONFIG_FILE_NAME=
SCRIPT_CONFIG=
HEADLESS_MODE=false

# Optional image overrides.
HUMMINGBOT_IMAGE=hummingbot/hummingbot:latest
HUMMINGBOT_GATEWAY_IMAGE=hummingbot/gateway:latest

# Local-area-network deployment target. Copy .deploy.lan.env.example to the
# ignored .deploy.lan.env when this Mac is used as the deployment host.
# Authentication uses the local SSH agent/keychain; never place an SSH password
# or private key value in this file.
LAN_SERVER_HOST=192.168.102.7
LAN_SERVER_USER=allenxing00
LAN_SSH_PORT=22
LAN_SSH_AUTH=agent
LAN_SSH_KEY=
# This is the remote Humm Control Plane repository, not the official engine.
LAN_CONTROL_PLANE_PATH=/Users/allenxing00/Documents/soft/hummingbot
# Keep the engine separate from the remote Humm Control Plane repository.
LAN_ENGINE_PATH=/Users/allenxing00/Documents/soft/hummingbot-engine
LAN_DOCKER_CONFIG=/Users/allenxing00/Documents/soft/hummingbot-engine/.docker
LAN_BUILDX_CONFIG=/Users/allenxing00/Documents/soft/hummingbot-engine/.buildx
LAN_PAPER_CONTAINER=hummingbot-pmm-mister-paper
LAN_ADMIN_BIND_HOST=192.168.102.7
LAN_ADMIN_PORT=3217
# Direct LAN access on the M2 host; bind only to its LAN IP, never 0.0.0.0.
LAN_ADMIN_URL=http://192.168.102.7:3217/admin
# Docker Desktop and docker compose were verified ready on the LAN host.
LAN_REQUIRES_DOCKER_DESKTOP=false
