# Strategy Parameters
# Swap strategy: max price deviation before triggering swap (e.g., 0.005 = 0.5%)
SWAP_PRICE_DEVIATION_THRESHOLD=0.005
# Swap amount in USDC per trade
SWAP_AMOUNT_USDC=100
# Polling interval in seconds
POLL_INTERVAL=30
                                            
# LP Strategy Parameters
# Number of LP positions to maintain
LP_POSITION_COUNT=3
# LP range width (e.g., 0.03 = ±3%)
LP_RANGE_PCT=0.03
# Rebalance threshold: when single-sided ratio exceeds this (e.g., 0.80 means 80% one-sided)
LP_REBALANCE_THRESHOLD=0.80
# Amount of liquidity per position (in USDC equivalent)
LP_AMOUNT_PER_POSITION=1000

# Slippage tolerance for swaps (e.g., 0.01 = 1%)
SLIPPAGE_TOLERANCE=0.01

# Gas settings
GAS_PRICE_GWEI=5
GAS_LIMIT=500000
